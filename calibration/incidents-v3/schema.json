{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "ecosystem",
    "package",
    "version_before",
    "version_after",
    "digest_before",
    "digest_after",
    "artifact_before",
    "artifact_after",
    "case_type",
    "label",
    "review_status",
    "source"
  ],
  "properties": {
    "id": { "type": "string" },
    "ecosystem": { "const": "npm" },
    "package": { "type": "string" },
    "version_before": { "type": "string" },
    "version_after": { "type": "string" },
    "digest_before": { "type": "string" },
    "digest_after": { "type": "string" },
    "artifact_before": { "type": ["string", "null"] },
    "artifact_after": { "type": ["string", "null"] },
    "registry_source": { "type": "string" },
    "publish_timestamps": { "type": "object" },
    "publisher_before": { "type": ["string", "null"] },
    "publisher_after": { "type": ["string", "null"] },
    "registry_history_events": { "type": "array" },
    "artifact_expectations": { "type": "object" },
    "case_type": { "type": "string" },
    "label": { "enum": ["known_incident", "known_benign", "ambiguous", "insufficient_evidence"] },
    "evidence_notes": { "type": "string" },
    "source_urls": { "type": "array", "items": { "type": "string" } },
    "review_status": { "const": "ai_assisted_unreviewed" },
    "source": { "enum": ["real_artifact_pair", "synthetic_from_real"] },
    "holdout_spent": { "type": "boolean" },
    "split": { "enum": ["development", "validation", "holdout"] }
  }
}
