{
  "name": "repo-radar",
  "version": "0.16.0",
  "description": "Evidence-driven repository and software supply-chain intelligence for GitHub repositories. Experimental preview.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "repo-radar": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "standards",
    "profiles",
    "schemas",
    "docs",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bundle": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/action/repo-radar.mjs \"--banner:js=import{createRequire as __rrCreateRequire}from'module';const require=__rrCreateRequire(import.meta.url);\"",
    "release:gates": "node scripts/check-release-gates.mjs",
    "calibrate": "npm run build && node scripts/calibrate.mjs",
    "package:action": "npm run bundle && node scripts/package-action.mjs",
    "schemas": "npm run build && node scripts/gen-schemas.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:versions": "node scripts/check-version-consistency.mjs",
    "check": "npm run check:versions && npm run typecheck && npm run lint && npm run format:check && npm test",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "openpgp": "6.3.2",
    "sigstore": "5.0.0",
    "smol-toml": "^1.3.1",
    "yaml": "^2.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
