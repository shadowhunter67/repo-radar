{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "dimension_weights": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "security",
          "maintenance",
          "code-quality",
          "supply-chain",
          "community",
          "documentation",
          "semantic-clarity"
        ]
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      }
    },
    "rule_weights": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      }
    },
    "minimums": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      }
    },
    "block": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{3,60}$"
          },
          "description": {
            "type": "string",
            "minLength": 5,
            "maxLength": 300
          },
          "when": {
            "$ref": "#/$defs/__schema0"
          },
          "on_unknown": {
            "default": "ignore",
            "type": "string",
            "enum": [
              "ignore",
              "block"
            ]
          }
        },
        "required": [
          "id",
          "description",
          "when"
        ],
        "additionalProperties": false
      }
    },
    "require": {
      "default": {},
      "type": "object",
      "properties": {
        "sbom": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "strict"
            }
          ]
        },
        "signed_release": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "strict"
            }
          ]
        },
        "provenance": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "strict"
            }
          ]
        },
        "checksums": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "strict"
            }
          ]
        },
        "verified_provenance": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "strict"
            }
          ]
        },
        "verified_source_binding": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "strict"
            }
          ]
        },
        "registry_repository_match": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "strict"
            }
          ]
        },
        "publisher_stability": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "strict"
            }
          ]
        },
        "locally_verified_signature": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "strict"
            }
          ]
        },
        "dependency_registry_match": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "strict"
            }
          ]
        },
        "dependency_publisher_stability": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "strict"
            }
          ]
        },
        "dependency_provenance_reported": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "strict"
            }
          ]
        },
        "dependency_verified_provenance": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "strict"
            }
          ]
        },
        "dependency_verified_source_binding": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "strict"
            }
          ]
        },
        "no_dependency_takeover_indicators": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "strict"
            }
          ]
        },
        "no_dependency_name_confusion": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "strict"
            }
          ]
        },
        "no_dependency_install_domains": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "strict"
            }
          ]
        },
        "dependency_artifacts_inspected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "strict"
            }
          ]
        },
        "no_young_dependencies": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "strict"
            }
          ]
        },
        "dependency_introductions_known": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "strict"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "history_block": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{3,60}$"
          },
          "description": {
            "type": "string",
            "minLength": 5,
            "maxLength": 300
          },
          "kind": {
            "type": "string",
            "enum": [
              "new_vulnerability",
              "new_install_hook",
              "new_install_time_remote_execution",
              "new_capability",
              "new_git_or_path_dependency",
              "takeover_indicators_with_new_install_hook",
              "new_install_time_domain",
              "provenance_verification_lost",
              "source_binding_conflict"
            ]
          },
          "capability": {
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "id",
          "description",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "temporal_block": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{3,60}$"
          },
          "description": {
            "type": "string",
            "minLength": 5,
            "maxLength": 300
          },
          "pattern": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9-]{3,60}$"
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]{3,60}$"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 300
                  },
                  "steps": {
                    "minItems": 2,
                    "maxItems": 6,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "any_of": {
                          "minItems": 1,
                          "maxItems": 8,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "commit",
                              "dormancy_end",
                              "new_committer",
                              "release",
                              "new_release_author",
                              "tag",
                              "registry_publish",
                              "new_publisher",
                              "publisher_change",
                              "maintainer_change",
                              "ownership_change",
                              "dependency_change",
                              "install_hook_introduced",
                              "capability_introduced",
                              "external_domain_introduced",
                              "provenance_change",
                              "signature_change",
                              "dependency_publisher_changed",
                              "dependency_maintainer_changed",
                              "dependency_repository_changed",
                              "dependency_dormancy_ended",
                              "dependency_release_cadence_changed",
                              "dependency_provenance_added",
                              "dependency_provenance_removed",
                              "dependency_install_hook_introduced",
                              "dependency_external_domain_introduced",
                              "dependency_external_domain_removed",
                              "dependency_external_domain_context_changed",
                              "dependency_name_confusion",
                              "external_domain_removed",
                              "external_domain_context_changed",
                              "provenance_added",
                              "provenance_removed",
                              "provenance_verification_changed",
                              "source_binding_changed",
                              "signature_state_changed",
                              "registry_repository_correspondence_changed"
                            ]
                          }
                        }
                      },
                      "required": [
                        "any_of"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "within_days": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 3650
                  },
                  "same_entity": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "description",
                  "steps",
                  "within_days"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "description",
          "pattern"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "version",
    "title",
    "description"
  ],
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "artifact_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "required": [
            "artifact_type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "domain": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "required": [
            "domain"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ecosystem": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "required": [
            "ecosystem"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "capability": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "required": [
            "capability"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "dependency": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 200
                },
                "relationship": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "dependency"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "execution": {
              "type": "object",
              "properties": {
                "stage": {
                  "type": "string"
                },
                "trigger_kind": {
                  "type": "string"
                },
                "repository_code": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "execution"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "distribution": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "required": [
            "distribution"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ai": {
              "anyOf": [
                {
                  "type": "boolean",
                  "const": true
                },
                {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                }
              ]
            }
          },
          "required": [
            "ai"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "privacy": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "required": [
            "privacy"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "fact": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "equals": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "gt": {
                  "type": "number"
                },
                "gte": {
                  "type": "number"
                },
                "lt": {
                  "type": "number"
                },
                "lte": {
                  "type": "number"
                },
                "exists": {
                  "type": "boolean"
                }
              },
              "required": [
                "id"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "fact"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 300
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "finding": {
              "type": "object",
              "properties": {
                "category": {
                  "type": "string"
                },
                "min_severity": {
                  "type": "string",
                  "enum": [
                    "info",
                    "low",
                    "medium",
                    "high"
                  ]
                },
                "rule_id": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "finding"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "context": {
              "type": "string",
              "maxLength": 100
            }
          },
          "required": [
            "context"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "title": "repo-radar profile"
}
