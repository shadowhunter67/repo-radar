# repo-radar web analyzer (all values are examples; do not put secrets here)
# GITHUB_TOKEN=
# PORT=8787
# HOST=127.0.0.1
# JOB_TTL_SECONDS=1800
# MAX_CONCURRENCY=2
# MAX_QUEUE=20
# RATE_LIMIT_PER_MINUTE=6
# RATE_LIMIT_HOURLY=40
# ANALYSIS_TIMEOUT_SECONDS=300
# MAX_REPORT_BYTES=26214400
# TRUST_PROXY=false
# REQUEST_BODY_LIMIT=4096
# NODE_ENV=development
# WORKER_MAX_OLD_SPACE_MB=512
# MAX_STORED_JOBS=200
# CACHE_TTL_SECONDS=600
# QUOTA_RESERVE=300
# ESTIMATED_REQUESTS_PER_JOB=60
# SHUTDOWN_GRACE_SECONDS=20
# PUBLIC_BASE_URL=https://your-host.example
# BUILD_COMMIT=
